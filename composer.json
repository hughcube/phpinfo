{
    "name": "hughcube/phpinfo",
    "description": "Restore phpinfo() plain text in CLI/Swoole/Workerman into 1:1 pixel-perfect native HTML across PHP versions.",
    "keywords": [
        "phpinfo",
        "swoole",
        "workerman",
        "cli",
        "html",
        "fpm"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "hugh.li",
            "email": "hugh.li@foxmail.com"
        }
    ],
    "require": {
        "php": ">=5.6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^5.7 || ^6.5 || ^7.5 || ^8.5 || ^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hughcube\\PhpInfo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hughcube\\PhpInfo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
